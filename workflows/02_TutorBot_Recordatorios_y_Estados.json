    {
      "parameters": {
        "jsCode": "\nconst tutorias = $('Leer Tutorias').all().map(i => i.json);\nconst estudiantes = $('Leer Estudiantes').all().map(i => i.json);\nconst tutores = $('Leer Tutores').all().map(i => i.json);\nconst materiasRows = $('Leer Materias').all().map(i => i.json);\nconst calificaciones = $('Leer Calificaciones').all().map(i => i.json).filter(c => c && c.id_tutoria);\n\nconst nombreMateria = id => { const m = materiasRows.find(x => String(x.id_materia) === String(id)); return m ? (m.nombre || m.materia || '') : String(id); };\nconst estudiantePorId = id => estudiantes.find(e => String(e.id_estudiante) === String(id));\nconst tutorPorId = id => tutores.find(t => String(t.id_tutor) === String(id));\n\nconst ahora = new Date();\n\nconst parseFechaHora = (fecha, hora) => {\n  try {\n    const p = String(fecha).split('/');\n    const d = new Date(p[2] + '-' + p[1].padStart(2,'0') + '-' + p[0].padStart(2,'0') + 'T' + String(hora).trim() + ':00');\n    return isNaN(d.getTime()) ? null : d;\n  } catch (e) { return null; }\n};\n\nconst minutosHasta = d => d ? (d.getTime() - ahora.getTime()) / 60000 : null;\n\nconst out = [];\n\nfor (const t of tutorias) {\n  const estado = String(t.estado || '');\n  const inicio = parseFechaHora(t.fecha, t.hora_inicio);\n  const fin = parseFechaHora(t.fecha, t.hora_fin);\n  if (!inicio || !fin) continue;\n\n  const minInicio = minutosHasta(inicio);\n  const minFin = minutosHasta(fin);\n  const est = estudiantePorId(t.id_estudiante);\n  const tut = tutorPorId(t.id_tutor);\n  const materia = nombreMateria(t.id_materia);\n  const yaCalificada = calificaciones.some(c => String(c.id_tutoria) === String(t.id_tutoria));\n\n  const base = {\n    id_tutoria: t.id_tutoria,\n    id_estudiante: t.id_estudiante,\n    id_tutor: t.id_tutor,\n    id_materia: t.id_materia,\n    motivo: t.motivo || '',\n    tema: t.tema || '',\n    fecha: t.fecha,\n    hora_inicio: t.hora_inicio,\n    hora_fin: t.hora_fin,\n    estado,\n    fecha_solicitud: t.fecha_solicitud || '',\n    fecha_asignacion: t.fecha_asignacion || '',\n    materia,\n    estudianteNombre: est ? est.nombre : '',\n    estudianteChatId: est ? String(est.telegram_id || '') : '',\n    tutorNombre: tut ? tut.nombre : '',\n    tutorChatId: tut ? String(tut.telegram_id || '') : '',\n  };\n\n  if (estado === 'Asignada') {\n    const r24 = String(t.recordatorio_24h_enviado || '').toLowerCase() === 'true';\n    const r1 = String(t.recordatorio_1h_enviado || '').toLowerCase() === 'true';\n    if (!r24 && minInicio > 60 && minInicio <= 24 * 60) {\n      out.push({ json: { ...base, accion: 'recordatorio', tipo: '24h', recordatorio_24h_enviado: 'true', recordatorio_1h_enviado: t.recordatorio_1h_enviado || '' } });\n    } else if (!r1 && minInicio > 0 && minInicio <= 60) {\n      out.push({ json: { ...base, accion: 'recordatorio', tipo: '1h', recordatorio_24h_enviado: t.recordatorio_24h_enviado || 'true', recordatorio_1h_enviado: 'true' } });\n    } else if (minInicio <= 0 && minFin > 0) {\n      out.push({ json: { ...base, accion: 'enCurso', nuevoEstado: 'En curso' } });\n    }\n  } else if (estado === 'En curso' && minFin <= 0) {\n    out.push({ json: { ...base, accion: 'finalizar', nuevoEstado: 'Finalizada', yaCalificada } });\n  }\n}\n\nreturn out;\n"
      },
